<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="Claude Explorer"
           Manufacturer="Station5 Solutions"
           Version="0.1.0"
           UpgradeCode="9E4A8F3D-2C7B-4E6A-B8D2-F1A4C9E7B3D5"
           Language="1033"
           Compressed="yes">

    <SummaryInformation Description="Claude Explorer — discover and manage Claude Code configuration" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Claude Explorer is already installed. Setup will now exit." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Install to Program Files\Claude Explorer -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Claude Explorer" />
    </StandardDirectory>

    <!-- Start Menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Claude Explorer">
        <Component Id="StartMenuShortcut" Guid="{3B2A1F5E-4C8D-7A9B-E1F2-A3B4C5D6E7F8}">
          <Shortcut Id="AppShortcut"
                    Name="Claude Explorer"
                    Description="Discover and manage Claude Code configuration"
                    Target="[INSTALLFOLDER]ClaudeExplorer.App.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\Station5\ClaudeExplorer"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)**" />
    </ComponentGroup>
  </Fragment>

</Wix>
