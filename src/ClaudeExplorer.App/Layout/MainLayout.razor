@inherits LayoutComponentBase
@implements IDisposable
@inject ShellViewModel Shell
@inject RefreshService Refresh
@inject EnvironmentService EnvService

<div class="app">
    <TopBar />
    <LeftRail Shell="Shell" />
    <main class="content">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Shell.PropertyChanged += OnShellChanged;
        Refresh.Requested += OnRefreshRequested;
        EnvService.Changed += OnEnvChanged;

        // Ensure environment service has data (it is loaded in DI singleton factory, but guard here too).
        if (!EnvService.Environments.Any())
            EnvService.Load();

        Shell.Load();
    }

    private void OnShellChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    private void OnRefreshRequested()
    {
        Shell.Load();
        InvokeAsync(StateHasChanged);
    }

    // Defer the refresh out of the event-dispatch chain so an environment switch doesn't run the
    // screens' synchronous disk-reads in the middle of handling the Changed event.
    private void OnEnvChanged() => InvokeAsync(Refresh.Request);

    public void Dispose()
    {
        Shell.PropertyChanged -= OnShellChanged;
        Refresh.Requested -= OnRefreshRequested;
        EnvService.Changed -= OnEnvChanged;
    }
}
