@using ClaudeExplorer.App.ViewModels
<aside class="rail">
    <div class="lbl">Workspace</div>
    <NavLink class="nav" href="/" Match="NavLinkMatch.All">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
        Dashboard
    </NavLink>
    <NavLink class="nav" href="effective">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18"/><path d="M5 7h14M5 12h9M5 17h6"/></svg>
        Effective Config
    </NavLink>
    <NavLink class="nav" href="commands">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m8 8-4 4 4 4"/><path d="m16 8 4 4-4 4"/></svg>
        Commands &amp; Skills <span class="count">@Shell?.CommandsAndSkills</span>
    </NavLink>
    <NavLink class="nav" href="mcp">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M3 9h6"/></svg>
        MCP &amp; Plugins @if (Shell?.HasMcpProblem == true) { <span class="count bad">1&#x2717;</span> }
    </NavLink>
    <NavLink class="nav" href="dependencies">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="M3 7l9 5 9-5M12 12v10"/></svg>
        Dependencies @if (Shell?.HasDependencyProblem == true) { <span class="count bad">1&#x2717;</span> }
    </NavLink>
    <div class="lbl">Discover</div>
    <NavLink class="nav" href="marketplace">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        Marketplace
    </NavLink>
    <NavLink class="nav" href="recommended">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Recommended
    </NavLink>
    <NavLink class="nav" href="changelog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M12 7v5l3 2M3 4v5h5"/></svg>
        Change Log
    </NavLink>
    <div class="foot">WORKSPACE LOADED<br>@(Shell?.ProjectLabel)<br>cli: see Dependencies</div>
</aside>

@code {
    [Parameter] public ShellViewModel? Shell { get; set; }
}
