@using ClaudeExplorer.App.ViewModels
@inject EnvironmentService EnvService
@implements IDisposable

<aside class="rail">
    <div class="lbl">Workspace</div>
    <NavLink class="nav" href="/" Match="NavLinkMatch.All">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
        Dashboard
    </NavLink>
    <NavLink class="nav" href="effective">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 3v18"/><path d="M5 7h14M5 12h9M5 17h6"/></svg>
        Effective Config
    </NavLink>
    <NavLink class="nav" href="dependencies">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2 3 7v10l9 5 9-5V7z"/><path d="M3 7l9 5 9-5M12 12v10"/></svg>
        Dependencies @if (Shell?.HasDependencyProblem == true) { <span class="count bad">1&#x2717;</span> }
    </NavLink>
    <NavLink class="nav" href="plugins">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M10 3v4H6a2 2 0 0 0-2 2v3h2.5a2.5 2.5 0 1 1 0 5H4v3a2 2 0 0 0 2 2h3v-2.5a2.5 2.5 0 1 1 5 0V22h3a2 2 0 0 0 2-2v-4h-4"/></svg>
        Plugins <span class="count">@Shell?.Plugins</span>
    </NavLink>

    <div class="lbl">Config Artifacts</div>
    <NavLink class="nav" href="commands">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m8 8-4 4 4 4"/><path d="m16 8 4 4-4 4"/></svg>
        Commands <span class="count">@Shell?.Commands</span>
    </NavLink>
    <NavLink class="nav" href="skills">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l3 6 6 .9-4.5 4.3 1 6.3L12 17.8 6.5 19.5l1-6.3L3 8.9 9 8z"/></svg>
        Skills <span class="count">@Shell?.Skills</span>
    </NavLink>
    <NavLink class="nav" href="subagents">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
        Subagents <span class="count">@Shell?.Subagents</span>
    </NavLink>
    <NavLink class="nav" href="memory">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h13l3 3v13H4z"/><path d="M8 4v6h8"/><path d="M8 14h8M8 17h5"/></svg>
        Memory
    </NavLink>
    <NavLink class="nav" href="hooks">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5v6a6 6 0 0 0 6 6h4"/><path d="m11 13 3 3-3 3"/></svg>
        Hooks @if (Shell?.HasHookProblem == true) { <span class="count bad">1&#x2717;</span> } else { <span class="count">@Shell?.Hooks</span> }
    </NavLink>
    <NavLink class="nav" href="mcp">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M3 9h6"/></svg>
        MCP @if (Shell?.HasMcpProblem == true) { <span class="count bad">1&#x2717;</span> } else { <span class="count">@Shell?.Mcp</span> }
    </NavLink>

    <div class="lbl">Discover</div>
    <NavLink class="nav" href="marketplace">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        Marketplace
    </NavLink>
    <NavLink class="nav" href="recommended">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        Recommended
    </NavLink>
    <NavLink class="nav" href="changelog">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M12 7v5l3 2M3 4v5h5"/></svg>
        Change Log
    </NavLink>

    <div class="foot">
        ENVIRONMENTS: @EnvService.Environments.Count<br>
        @foreach (var env in EnvService.Environments)
        {
            @($"● {env.Name}")<br>
        }
        cli: see Dependencies
    </div>
</aside>

@code {
    [Parameter] public ShellViewModel? Shell { get; set; }

    protected override void OnInitialized() => EnvService.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => EnvService.Changed -= OnChanged;
}
