@inject EnvironmentService EnvService
<header class="topbar">
    <div class="brand"><span class="mark"></span> Claude&nbsp;Explorer</div>
    <span class="coord">FIG.01 — ENVIRONMENT SCHEMATIC</span>
    <div class="spacer"></div>
    <EnvironmentSelector />
    <div class="iconbtn" title="Re-discover environments &amp; refresh" @onclick="OnRefreshClicked">
        <svg viewBox="0 0 24 24" width="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M21 12a9 9 0 1 1-3-6.7L21 8" /><path d="M21 3v5h-5" />
        </svg>
    </div>
</header>

@code {
    // Re-run environment discovery (picks up a newly-created ~/.claude, e.g. in WSL) AND refresh the
    // current screens. EnvironmentService.Refresh() raises Changed, which MainLayout turns into a
    // RefreshService.Request() — so a single click both re-discovers and reloads data.
    private void OnRefreshClicked() => EnvService.Refresh();
}
