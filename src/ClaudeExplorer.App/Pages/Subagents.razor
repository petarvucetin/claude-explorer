@page "/subagents"
@using ClaudeExplorer.App.Screens.Artifacts
@using ClaudeExplorer.Core.Artifacts
@inject ArtifactBrowserViewModel Vm
@inject RefreshService Refresh
@inject ClaudeExplorer.Core.Io.IFileSystem Fs
@implements IDisposable

<div class="pagehead">
    <div><div class="k">Subagents</div><h1>Subagents</h1></div>
    <div class="scope">@Vm.Groups.Sum(g => g.Items.Count) SUBAGENTS<br />tools &amp; model per agent</div>
</div>
<CompareBar />
<DiffOverlay Category="Subagents" />

@if (Vm.IsLoading)
{
    <CornerTickPanel Class="card"><div class="sub" style="padding:18px">Loading…</div></CornerTickPanel>
}
else if (Vm.ErrorMessage is not null)
{
    <CornerTickPanel Class="card error-panel"><div class="rowx"><div class="glyph bad"></div>
        <div class="body"><div class="ttl">Failed to load subagents</div><div class="meta">@Vm.ErrorMessage</div></div></div></CornerTickPanel>
}
else
{
    <div class="filter-row">
        <input class="search-box" type="search" placeholder="Search subagents…"
               value="@Vm.Search" @oninput="e => Vm.Search = e.Value?.ToString() ?? string.Empty" />
    </div>
    <div class="browser-layout">
        <CornerTickPanel Class="card master-panel">
            @if (!Vm.Groups.Any()) { <div class="sub" style="padding:16px">No subagents found.</div> }
            @foreach (var group in Vm.Groups)
            {
                <div class="master-group-label">@group.Label</div>
                @foreach (var item in group.Items)
                {
                    var sel = item;
                    <div class="master-item @(Vm.Selected == item ? "selected" : "")" @onclick="() => Vm.Selected = sel">
                        <span class="master-item-name">@item.Name</span>
                        @if (item.IsShadowing) { <span class="shadow-badge">SHADOWS</span> }
                    </div>
                }
            }
        </CornerTickPanel>
        <div class="detail-panel">
            @if (Vm.Selected is { } s)
            {
                <CornerTickPanel Class="card" style="padding:18px">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
                        <h2 style="margin:0;font-size:19px">@s.Name</h2>
                        @if (s.Frontmatter.TryGetValue("model", out var model)) { <span class="badge">@model</span> }
                    </div>
                    @if (!string.IsNullOrEmpty(s.Summary)) { <div class="detail-summary" style="margin-bottom:10px">@s.Summary</div> }
                    @{ var tools = ArtifactDetail.ToolChips(s.Frontmatter.GetValueOrDefault("tools")); }
                    @if (tools.Count > 0)
                    {
                        <div class="fieldlabel">Tools — @tools.Count</div>
                        <div class="toolchips">
                            @foreach (var t in tools) { <span class="toolchip">@t</span> }
                        </div>
                    }
                    <div class="kv">
                        <span class="kvk">model</span><span class="kvv">@s.Frontmatter.GetValueOrDefault("model", "inherit")</span>
                        <span class="kvk">file</span><span class="kvv">@s.FilePath</span>
                    </div>
                    @if (Fs.FileExists(s.FilePath))
                    {
                        <div style="margin-top:12px"><MarkdownViewer Title="@s.FilePath" Content="@Fs.ReadAllText(s.FilePath)" /></div>
                    }
                </CornerTickPanel>
            }
            else
            {
                <CornerTickPanel Class="card"><div class="sub" style="padding:24px;text-align:center;color:var(--ink-faint)">Select a subagent to see details.</div></CornerTickPanel>
            }
        </div>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnVmChanged;
        Refresh.Requested += OnRefreshRequested;
        Vm.KindFilter = ArtifactKind.Subagent;
        Vm.Load();
    }

    private void OnVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);
    private void OnRefreshRequested() => Vm.Load();

    public void Dispose()
    {
        Vm.PropertyChanged -= OnVmChanged;
        Refresh.Requested -= OnRefreshRequested;
    }
}
